# ==============================================================================
# ZORAH BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.production' or '.env.staging' and populate with actual credentials.
# DO NOT commit actual credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Port binding (Production default: 4000, Staging default: 4001)
PORT=4000

# Application environment mode (production | staging | development)
NODE_ENV=production

# Security & Authentication Secrets
# Generate strong, random 64-character strings for production JWT secrets
JWT_SECRET=your_jwt_access_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Password Hashing Salt Rounds (Default: 10)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI
# Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zorah_production
# Staging:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zorah_staging
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zorah_production

# ------------------------------------------------------------------------------
# 3. XPRESS WALLET INTEGRATION
# ------------------------------------------------------------------------------
# Base API URL for Xpress Wallet services
XPRESS_WALLET_API_URL=https://payment.xpress-wallet.com/api/v1

# Secret Key for Xpress Wallet API authorization
# Production: sk_live_...
# Staging:    sk_sandbox_...
XPRESS_WALLET_SECRET_KEY=sk_live_your_xpress_secret_key_here

# Secret Key for verifying incoming Xpress Wallet Webhooks signature
XPRESS_WEBHOOK_SECRET=sk_live_your_xpress_webhook_secret_here

# Optional: Pooled Wallet Customer ID (if using pooled funding features)
XPRESS_POOL_CUSTOMER_ID=your_xpress_pool_customer_id_here

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# Host server for outbound emails (e.g., smtp.gmail.com, smtp.mailgun.org)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP Authentication credentials
SMTP_USER=info@getzorah.com
SMTP_PASS=your_smtp_app_password_here

# ------------------------------------------------------------------------------
# 5. THIRD-PARTY AI & AUTH SERVICES
# ------------------------------------------------------------------------------
# Google Gemini Generative AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID (for Google Sign-In verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 6. AWS INFRASTRUCTURE (S3 Storage for KYC Documents)
# ------------------------------------------------------------------------------
# AWS IAM User Credentials with S3 permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=zorah-kyc-documents

# ------------------------------------------------------------------------------
# 7. FIREBASE ADMIN SDK CONFIGURATION
# ------------------------------------------------------------------------------
# Firebase Project ID
FIREBASE_PROJECT_ID=zorah-e5958

# Firebase Admin Service Account Email
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@zorah-e5958.iam.gserviceaccount.com

# Firebase Admin Service Account Private Key
# Note: Ensure multiline key formatting or escaped newlines (\n) are preserved
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
