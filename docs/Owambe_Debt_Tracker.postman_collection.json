          "name": "1. Create Event Budget",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response structure is valid', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.data).to.have.property('_id');",
                  "    pm.expect(jsonData.data.totalSpent).to.eql(0);",
                  "    pm.environment.set('eventId', jsonData.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lagos Wedding Owambe 2026\",\n  \"targetBudget\": 500000,\n  \"categoryTags\": [\"aso ebi\", \"transport\", \"gift money\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/owambe/events",
              "host": ["{{base_url}}"],
              "path": ["owambe", "events"]
            }
          }
        },
        {
          "name": "2. Get All Event Budgets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
