                  "});",
                  "pm.test('Response contains array of budgets', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
